AddType application/javascript .js
AddType application/javascript .mjs

<FilesMatch "\.(js|mjs)$">
    Header set Content-Type "application/javascript"
    Header set Access-Control-Allow-Origin "*"
</FilesMatch>

<FilesMatch "\.(html|htm)$">
    Header set Content-Type "text/html; charset=UTF-8"
</FilesMatch>
