    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // ΑΠΟΤΡΟΠΗ ZOOM ΣΕ IOS
            document.addEventListener('touchstart', function(event) {
                if (event.touches.length > 1) event.preventDefault();
            }, { passive: false });
            
            let lastTouchEnd = 0;
            document.addEventListener('touchend', function(event) {
                const now = (new Date()).getTime();
                if (now - lastTouchEnd <= 300) event.preventDefault();
                lastTouchEnd = now;
            }, false);
            
            // Προσαρμογή πλάτους tickers
            function adjustTickersWidth() {
                const containers = document.querySelectorAll('.ticker-container > div');
                const iframes = document.querySelectorAll('.ticker-container iframe');
                const isMobile = window.innerWidth <= 768;
                
                containers.forEach(container => {
                    if (container && isMobile) container.style.width = '100%';
                });
                
                iframes.forEach(iframe => {
                    if (iframe && isMobile) {
                        iframe.style.width = '100%';
                        iframe.style.maxWidth = '100%';
                    }
                });
            }
            
            // Διαχείριση sticky mobile ad
            const stickyMobileAd = document.getElementById('stickyMobileAd');
            const closeStickyAdBtn = document.getElementById('closeStickyAd');
            
            function hasUserClosedStickyAd() {
                return localStorage.getItem('stickyMobileAdClosed') === 'true';
            }
            
            function handleStickyMobileAd() {
                const isMobile = window.innerWidth <= 768;
                
                if (isMobile && !hasUserClosedStickyAd()) {
                    setTimeout(() => {
                        stickyMobileAd.style.display = 'flex';
                    }, 1500);
                } else {
                    stickyMobileAd.style.display = 'none';
                }
            }
            
            function closeStickyMobileAd() {
                stickyMobileAd.style.display = 'none';
                localStorage.setItem('stickyMobileAdClosed', 'true');
            }
            
            closeStickyAdBtn.addEventListener('click', closeStickyMobileAd);
            
            setTimeout(() => {
                if (stickyMobileAd.style.display === 'flex') closeStickyMobileAd();
            }, 12000);
            
            // Initialize Ads
            function initializeAds() {
                if (window.adsbygoogle) {
                    try {
                        (adsbygoogle = window.adsbygoogle || []).push({});
                    } catch (e) {
                        console.error('Error initializing ads:', e);
                    }
                } else {
                    setTimeout(initializeAds, 1000);
                }
            }
            
            // Lazy load ads on scroll
            let adsInitialized = false;
            window.addEventListener('scroll', function() {
                if (!adsInitialized) {
                    initializeAds();
                    adsInitialized = true;
                }
            });
            
            // Αρχικές ρυθμίσεις
            adjustTickersWidth();
            window.addEventListener('resize', adjustTickersWidth);
            handleStickyMobileAd();
            window.addEventListener('resize', handleStickyMobileAd);
            
            // Αρχικοποίηση διαφημίσεων
            setTimeout(initializeAds, 800);
        });
    </script>
    
